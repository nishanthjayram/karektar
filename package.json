{
  "name": "karektar",
  "private": true,
  "homepage": "https://nishanthjayram.github.io/karektar",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:auth": "npm run build && npx wrangler pages dev dist --port 8788 --kv MY_KV",
    "predeploy": "yarn run build",
    "deploy": "gh-pages -d dist",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint '{src,functions}/**/*.{js,jsx,ts,tsx,json}'",
    "lint:fix": "eslint --fix '{src,functions}/**/*.{js,jsx,ts,tsx,json}'",
    "format": "prettier --write '{src,functions}/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run build && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@tippy.js/react": "^3.1.1",
    "@types/opentype": "^0.0.4",
    "@types/react-modal": "^3.16.0",
    "opentype.js": "^1.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-modal": "^3.16.1",
    "react-responsive": "^9.0.2",
    "vite-plugin-svgr": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "@vitejs/plugin-react": "^3.0.0",
    "classnames": "^2.3.2",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-etc": "^2.0.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^5.0.0",
    "prettier": "2.8.4",
    "sass": "^1.57.1",
    "typescript": "^4.9.3",
    "vite": "^4.1.5",
    "vitest": "^4.1.8"
  }
}
