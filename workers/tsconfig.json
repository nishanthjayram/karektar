{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2020",
		"module": "ES2022",
		"lib": ["ES2020"],
		"types": ["@cloudflare/workers-types"],
		"moduleResolution": "node",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["src/*"],
			"@common/*": ["../common/*"],
			"@constants/*": ["src/constants/*"],
			"@handlers/*": ["src/handlers/*"],
			"@utils/*": ["src/utils/*"]
		}
	},
	"include": ["src/**/*", "../common/**/*"]
}
